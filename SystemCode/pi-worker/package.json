{
  "name": "buildrig-pi-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:local": "node_modules\\node\\bin\\node.exe node_modules\\typescript\\bin\\tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:local": "node_modules\\node\\bin\\node.exe --env-file=../.env dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "node": "22.19.0",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3"
  }
}
