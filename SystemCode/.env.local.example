BUILDRIG_RETRIEVAL_BACKEND=local
BUILDRIG_STATE_DB=runtime/buildrig.db
BUILDRIG_MAX_REVISIONS=2
BUILDRIG_TOP_K=8
BUILDRIG_INTERNAL_API_TOKEN=local-development-token
BUILDRIG_MODEL=qwen3:8b
BUILDRIG_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
BUILDRIG_OLLAMA_REASONING=false
BUILDRIG_OLLAMA_NUM_CTX=8192
BUILDRIG_OLLAMA_NUM_PREDICT=1200
BUILDRIG_EMBEDDING_PROVIDER=ollama
BUILDRIG_EMBEDDING_MODEL=bge-m3
BUILDRIG_EMBEDDING_DIMENSIONS=1024
BUILDRIG_EMBEDDING_BATCH_SIZE=32
BUILDRIG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BUILDRIG_PI_RUNTIME_URL=http://127.0.0.1:8090
BUILDRIG_PI_RUNTIME_TIMEOUT_SECONDS=300
