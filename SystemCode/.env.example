# Default profile: everything runs locally via `docker compose up -d`
# (Neo4j + Milvus + Ollama). Copy this file to .env and adjust if needed.

BUILDRIG_RETRIEVAL_BACKEND=neo4j_milvus
BUILDRIG_STATE_DB=runtime/buildrig.db
BUILDRIG_MAX_REVISIONS=3
BUILDRIG_TOP_K=8
BUILDRIG_INTERNAL_API_TOKEN=replace-with-a-random-service-token

# Local models served by Ollama (the `ollama` container, or a native install on the
# same port). No OpenAI key is required.
BUILDRIG_MODEL=qwen3:8b
BUILDRIG_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
BUILDRIG_OLLAMA_REASONING=false
# With a native Ollama install, also set OLLAMA_CONTEXT_LENGTH to this value for the Ollama server
# (docker-compose.yml does it for the container), or the model reloads between DAG and Pi calls.
BUILDRIG_OLLAMA_NUM_CTX=8192
BUILDRIG_OLLAMA_NUM_PREDICT=1200
BUILDRIG_EMBEDDING_PROVIDER=ollama
BUILDRIG_EMBEDDING_MODEL=bge-m3
BUILDRIG_EMBEDDING_DIMENSIONS=1024
BUILDRIG_EMBEDDING_BATCH_SIZE=32

# Local Neo4j container. docker-compose.yml reads NEO4J_PASSWORD from this file too.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=buildrig-local-dev
NEO4J_DATABASE=neo4j

# Local Milvus container (no authentication in development).
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_COLLECTION=buildrig_chunks_bge_m3_v2

# Optional cloud alternative: Neo4j Aura (neo4j+s://...) and Zilliz Cloud (https://...).
# NEO4J_URI=neo4j+s://replace-with-your-instance.databases.neo4j.io
# NEO4J_PASSWORD=replace-with-neo4j-password
# MILVUS_URI=https://replace-with-your-cluster.zillizcloud.com
# MILVUS_TOKEN=replace-with-zilliz-token

BUILDRIG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Pi Agent Worker (pi-worker/), started separately.
BUILDRIG_PI_RUNTIME_URL=http://127.0.0.1:8090
BUILDRIG_PI_RUNTIME_TIMEOUT_SECONDS=300
