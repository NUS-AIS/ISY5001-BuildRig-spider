# Production profile: local Ollama models + cloud Neo4j/Milvus.
BUILDRIG_RETRIEVAL_BACKEND=neo4j_milvus
BUILDRIG_STATE_DB=runtime/buildrig.db
BUILDRIG_MAX_REVISIONS=2
BUILDRIG_TOP_K=8
BUILDRIG_INTERNAL_API_TOKEN=replace-with-a-random-service-token
# Local LangChain models served by Ollama. No OpenAI key is required.
BUILDRIG_MODEL=qwen3:8b
BUILDRIG_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
BUILDRIG_OLLAMA_REASONING=false
BUILDRIG_OLLAMA_NUM_CTX=8192
BUILDRIG_OLLAMA_NUM_PREDICT=1200
BUILDRIG_EMBEDDING_PROVIDER=ollama
BUILDRIG_EMBEDDING_MODEL=bge-m3
BUILDRIG_EMBEDDING_DIMENSIONS=1024
BUILDRIG_EMBEDDING_BATCH_SIZE=32

# Neo4j Aura uses neo4j+s://... and Zilliz Cloud uses https://... endpoints.
NEO4J_URI=neo4j+s://replace-with-your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j
MILVUS_URI=https://replace-with-your-cluster.api.gcp-us-west1.zillizcloud.com
MILVUS_TOKEN=replace-with-zilliz-token
# If the cluster provides database credentials instead of a token, leave
# MILVUS_TOKEN empty and set these two fields.
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_COLLECTION=buildrig_evidence_bge_m3_v1

BUILDRIG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# URL of a separately deployed Pi Agent Worker.
BUILDRIG_PI_RUNTIME_URL=http://localhost:8090
BUILDRIG_PI_RUNTIME_TIMEOUT_SECONDS=600
